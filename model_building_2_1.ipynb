    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "baseline_rf = RandomForestClassifier(n_estimators=300, class_weight=\"balanced\",\n",
    "                                      random_state=RANDOM_STATE, n_jobs=-1)\n",
