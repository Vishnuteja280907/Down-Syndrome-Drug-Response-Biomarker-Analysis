     "shell.execute_reply": "2026-07-17T05:52:55.363695Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train set: 864 mice\n",
      "Test set:  216 mice\n",
      "\n",
      "Imputation done leakage-safe: imputer was fit on train data only, then applied unchanged to test data.\n"
     ]
    }
   ],
   "source": [
    "# STEP 1: split BEFORE imputing anything\n",
    "X_train_raw, X_test_raw, y_train, y_test = train_test_split(\n",
    "    X_raw, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "\n",
    "print(f\"Train set: {X_train_raw.shape[0]} mice\")\n",
    "print(f\"Test set:  {X_test_raw.shape[0]} mice\")\n",
    "\n",
    "# STEP 2: fit imputer on TRAIN ONLY\n",
    "knn_imputer = KNNImputer(n_neighbors=5)\n",
    "X_train = pd.DataFrame(knn_imputer.fit_transform(X_train_raw), columns=protein_cols,\n",
    "                        index=X_train_raw.index)\n",
    "\n",
    "# STEP 3: use the SAME fitted imputer to transform test (no re-fitting!)\n",
    "X_test = pd.DataFrame(knn_imputer.transform(X_test_raw), columns=protein_cols,\n",
    "                       index=X_test_raw.index)\n",
    "\n",
    "print(\"\\nImputation done leakage-safe: imputer was fit on train data only, \"\n",
    "      \"then applied unchanged to test data.\")\n"
   ]
  },
