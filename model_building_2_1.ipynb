    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Classes: ['c-CS-m', 'c-CS-s', 'c-SC-m', 'c-SC-s', 't-CS-m', 't-CS-s', 't-SC-m', 't-SC-s']\n",
      "Raw feature matrix shape (pre-imputation): (1080, 77)\n"
     ]
    }
   ],
   "source": [
    "df_raw = pd.read_excel(\"Data_Cortex_Nuclear.xls\")\n",
    "protein_cols = [c for c in df_raw.columns if c not in\n",
    "                [\"MouseID\", \"Genotype\", \"Treatment\", \"Behavior\", \"class\"]]\n",
    "\n",
    "le = LabelEncoder()\n",
    "y = le.fit_transform(df_raw[\"class\"])\n",
    "X_raw = df_raw[protein_cols]  # still contains missing values at this point\n",
    "\n",
    "print(\"Classes:\", list(le.classes_))\n",
    "print(\"Raw feature matrix shape (pre-imputation):\", X_raw.shape)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "75f54142",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T05:52:55.215953Z",
